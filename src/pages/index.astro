---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeDial from '../components/ThemeDial.astro';
import WorkList from '../components/WorkList.astro';
import Icon from '../components/Icon.astro';
import BrandLogo from '../components/BrandLogo.astro';
---

<BaseLayout>
  <section class="home-intro" aria-labelledby="hello">
    <div class="home-intro__heading">
      <div>
        <p class="eyebrow">hey there <span aria-hidden="true">✳</span></p><h1
          id="hello"
        >
          I'm Gabby<span class="heading-dot">.</span>
        </h1>
      </div>
      <ThemeDial />
    </div>
    <div class="home-intro__copy">
      <p>
        I’m a <span class="inline-emphasis"
          ><span aria-hidden="true">👩🏻‍💻</span> software engineer</span
        >, cat mom to Nori and Kimchi, collector of hobbies, and a curious
        lifelong learner. I live in San Francisco, but New England will always
        feel like home.
      </p>
      <p>
        These days, I’m helping people find meaningful work training next-gen AI
        models as a founding engineer at <a
          class="inline-link inline-link--sage inline-link--brand"
          href="https://joinhandshake.com/ai"
          ><BrandLogo name="handshake" /> Handshake AI</a
        >, tinkering on some (still top-secret) side projects, and finding time
        to <a class="inline-link inline-link--sage" href="/garden/"
          ><Icon name="plant" /> tend to my digital garden</a
        >.
      </p>
      <p>
        Before Handshake, I grew from an engineering apprentice into a senior
        software engineer at <a
          class="inline-link inline-link--brand"
          href="https://en.wikipedia.org/wiki/LinkedIn"
          ><BrandLogo name="linkedin" /> LinkedIn</a
        >. I learned to code at <a
          class="inline-link inline-link--brand"
          href="https://en.wikipedia.org/wiki/Hack_Reactor"
          ><BrandLogo name="hack-reactor" /> Hack Reactor</a
        >, where I later taught as a Software Engineer in Residence. Some of the
        work I’m proudest of has been making software more accessible and
        helping other engineers from nontraditional backgrounds find their
        footing.
      </p>
      <p>
        My path into tech had a few side quests. After studying political
        science and leadership studies at <a
          class="inline-link inline-link--brand"
          href="https://www.williams.edu/"
          ><BrandLogo name="williams" /> Williams College</a
        >, I worked as a business analyst at a language-learning startup, a
        community marketer at a values-driven solar company in Vermont, and an
        independent SAT tutor.
      </p>
      <p>
        Away from work, you might find me tinkering with my <span
          class="inline-emphasis"><Icon name="coffee" /> espresso setup</span
        >, lost in a good book, or spelunking down a Wikipedia rabbit hole. I
        love journaling and collecting stationery, trying my hand at photography
        around San Francisco, and cooking for friends and family—with a cozy
        game or some quality cat time in between.
      </p>
      <p>
        This is my little home on the internet. A place for <a
          class="inline-link inline-link--rose"
          href="/blog/"><Icon name="notebook" /> words</a
        >, <a class="inline-link inline-link--sage" href="/garden/"
          ><Icon name="flower" /> growing things</a
        >, and whatever comes next. Make yourself at home.
      </p>
    </div>
    <a class="quiet-link home-intro__now" href="/now/"
      ><span class="home-intro__status" aria-hidden="true"></span> What I'm up to
      now <Icon name="right" /></a
    >
  </section>
  <section class="home-work" aria-labelledby="work-heading">
    <div class="home-work__heading">
      <h2 id="work-heading">Work</h2><a href="/resume/" class="quiet-link"
        >The longer version <Icon name="arrow" /></a
      >
    </div>
    <WorkList />
  </section>
  <aside class="garden-invitation">
    <Icon name="plant" /><p>
      There's a little more down the garden path.<br /><a href="/garden/"
        >Take a look around <Icon name="right" /></a
      >
    </p><span aria-hidden="true" class="garden-invitation__asterisk">✳</span>
  </aside>
</BaseLayout>

<style>
  .home-intro__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 32px;
  }

  .eyebrow span {
    display: inline-block;
    padding-left: 5px;
    color: var(--rose);
    font-size: 0.9375rem;
  }

  .home-intro__copy p + p {
    margin-top: 20px;
  }

  .inline-link {
    --icon-size: 21px;
    font-weight: 550;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .inline-link--brand {
    white-space: nowrap;
  }

  .inline-link--sage {
    color: var(--sage);
  }

  .inline-link--rose {
    color: var(--rose);
  }

  .inline-emphasis {
    --icon-size: 21px;
    --icon-color: var(--gold);
    font-weight: 500;
  }

  .inline-emphasis > span {
    margin-right: 3px;
    font-size: 1.1875rem;
  }

  .home-intro__now {
    margin-top: 28px;
  }

  .home-intro__status {
    width: 6px;
    height: 6px;
    margin-right: 2px;
    background: var(--sage);
    border-radius: 50%;
  }

  .home-work {
    margin-top: 57px;
  }

  .home-work__heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 21px;
  }

  .garden-invitation {
    --icon-size: 28px;
    --icon-color: var(--sage);
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 42px;
    padding: 19px 22px;
    background: var(--sage-soft);
    border-radius: 5px 17px 17px 17px;
  }

  .garden-invitation p {
    font-size: 0.8125rem;
    line-height: 1.9;
  }

  .garden-invitation a {
    --icon-size: 14px;
    color: var(--sage);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .garden-invitation a:hover {
    text-decoration: underline;
  }

  .garden-invitation__asterisk {
    margin-left: auto;
    color: var(--sage);
    font-size: 1.375rem;
    opacity: 0.55;
  }

  @media (max-width: 600px) {
    .home-intro__heading {
      margin-bottom: 25px;
    }

    .garden-invitation {
      gap: 12px;
      padding: 16px;
    }
  }
</style>
