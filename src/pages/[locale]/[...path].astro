---
import type { CollectionEntry } from 'astro:content';
import BlogIndex from '../../components/pages/BlogIndex.astro';
import BlogPost from '../../components/pages/BlogPost.astro';
import GardenIndex from '../../components/pages/GardenIndex.astro';
import WritingPage from '../../components/pages/WritingPage.astro';
import HomePage from '../../components/pages/HomePage.astro';
import ResumePage from '../../components/pages/ResumePage.astro';
import { availablePaths, localizedEntries } from '../../i18n/content';
import { locales, contentIdentity } from '../../i18n/locales';

export async function getStaticPaths() {
  return (
    await Promise.all(
      locales
        .filter((locale) => locale !== 'en')
        .map(async (locale) => {
          const paths = await availablePaths(locale);
          if (!paths.size) return [];
          const entries = await Promise.all(
            (['blog', 'pages', 'notes'] as const).map(async (collection) =>
              (await localizedEntries(collection, locale)).map((entry) => {
                const { slug } = contentIdentity(entry.id);
                const path =
                  collection === 'blog'
                    ? `blog/${slug}`
                    : collection === 'notes'
                      ? `garden/${slug}`
                      : slug;
                return {
                  params: { locale: locale.toLowerCase(), path },
                  props: { entry },
                };
              }),
            ),
          );
          return [
            ...entries.flat(),
            {
              params: { locale: locale.toLowerCase(), path: 'blog' },
              props: {},
            },
            {
              params: { locale: locale.toLowerCase(), path: undefined },
              props: { shell: 'home' },
            },
            {
              params: { locale: locale.toLowerCase(), path: 'resume' },
              props: { shell: 'resume' },
            },
          ];
        }),
    )
  ).flat();
}

interface Props {
  shell?: 'home' | 'resume';
  entry?:
    | CollectionEntry<'blog'>
    | CollectionEntry<'pages'>
    | CollectionEntry<'notes'>;
}
const { entry, shell } = Astro.props;
---

{
  shell === 'home' ? (
    <HomePage />
  ) : shell === 'resume' ? (
    <ResumePage />
  ) : !entry ? (
    <BlogIndex />
  ) : entry.collection === 'blog' ? (
    <BlogPost post={entry} />
  ) : entry.collection === 'pages' &&
    contentIdentity(entry.id).slug === 'garden' ? (
    <GardenIndex />
  ) : (
    <WritingPage entry={entry} />
  )
}
