---
import WritingPage from '../components/pages/WritingPage.astro';
import { localizedEntries } from '../i18n/content';
import { contentIdentity } from '../i18n/locales';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  return (await localizedEntries('pages'))
    .filter((entry) => contentIdentity(entry.id).slug !== 'garden')
    .map((entry) => ({
      params: { page: contentIdentity(entry.id).slug },
      props: { entry },
    }));
}
interface Props {
  entry: CollectionEntry<'pages'>;
}
---

<WritingPage entry={Astro.props.entry} />
