---
import { icons, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<span
  class:list={['icon', className]}
  aria-hidden="true"
  set:html={icons[name]}
/>

<style>
  /* Parents may set --icon-size and --icon-color without reaching into markup. */
  .icon {
    display: inline-flex;
    flex-shrink: 0;
    width: var(--icon-size, 1.25em);
    height: var(--icon-size, 1.25em);
    color: var(--icon-color, currentColor);
    vertical-align: -0.23em;
  }

  /* SVG is inserted from the trusted icon library and has no Astro scope. */
  .icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
