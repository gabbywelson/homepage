---
// Hidden until enhancement is ready; the page follows the system theme without JS.
---

<div class="theme-control">
  <button
    class="theme-dial"
    data-theme-toggle
    type="button"
    aria-label="Dark mode"
    aria-pressed="false"
    title="Switch to dark mode"
    hidden
  >
    <span class="dial-case" aria-hidden="true">
      <span class="dial-sky">
        <svg class="dial-stars" viewBox="0 0 44 18" fill="currentColor">
          <path d="M6 0Q7 5 12 6Q7 7 6 12Q5 7 0 6Q5 5 6 0Z"></path>
          <circle cx="33" cy="13" r="1"></circle>
          <circle cx="41" cy="5" r="1.5" fill="none" stroke="currentColor"
          ></circle>
        </svg>
        <span class="dial-orbit">
          <svg class="dial-sun" viewBox="0 0 40 40" fill="none">
            <g stroke="currentColor" stroke-width="2.3" stroke-linecap="round">
              <path
                d="M20 2v4m0 28v4M2 20h4m28 0h4M7.3 7.3l2.9 2.9m19.6 19.6 2.9 2.9M7.3 32.7l2.9-2.9m19.6-19.6 2.9-2.9"
              ></path>
              <circle cx="20" cy="20" r="10.5" fill="currentColor" stroke="none"
              ></circle>
            </g>
            <g stroke="#765026" stroke-width="1.4" stroke-linecap="round"
              ><path d="M16.5 18.5v1m7-1v1m-6 3q2.5 2.5 5 0"></path></g
            >
          </svg>
          <svg class="dial-moon" viewBox="0 0 40 40" fill="none">
            <path
              d="M30.5 26.5A14.5 14.5 0 0 1 14 5a15 15 0 1 0 16.5 21.5Z"
              fill="currentColor"></path>
            <path
              d="M14 24q1.8 2 3.6 0m2.3 4q2 1 3.5-.8"
              stroke="#665580"
              stroke-width="1.4"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="dial-horizon"></span>
        <span class="dial-ground"><span></span></span>
      </span>
      <span class="dial-tick"></span>
    </span>
  </button>
  <span class="theme-hint" aria-hidden="true"
    ><span class="day-hint">a little moonlight?</span><span class="night-hint"
      >a little sunshine?</span
    ></span
  >
</div>

<script>
  import { initializeThemeDial } from '../scripts/theme';

  initializeThemeDial();
</script>

<style>
  .theme-control {
    width: 106px;
    height: 112px;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .theme-dial {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: column;
    width: 106px;
    -webkit-tap-highlight-color: transparent;
  }
  .theme-dial[hidden] {
    display: none;
  }
  .dial-case {
    display: block;
    width: 86px;
    height: 86px;
    padding: 7px;
    position: relative;
    border-radius: 50%;
    background: var(--dial-case);
    box-shadow:
      0 1px 0 #fff8 inset,
      0 0 0 1px var(--line),
      0 4px 9px #25342812;
    transform: rotate(-8deg);
  }
  .dial-sky {
    display: block;
    width: 72px;
    height: 72px;
    position: relative;
    overflow: hidden;
    border-radius: 50%;
    background: var(--dial-sky);
    box-shadow: 0 1px 4px #25342820 inset;
  }
  .dial-orbit {
    position: absolute;
    width: 72px;
    height: 90px;
    top: 0;
    left: 0;
    transform: rotate(0deg);
  }
  .dial-sun,
  .dial-moon {
    position: absolute;
    width: 30px;
    height: 30px;
    left: 21px;
  }
  .dial-sun {
    top: 7px;
    color: #d69b48;
  }
  .dial-moon {
    bottom: 7px;
    color: #e8dfb4;
    transform: rotate(180deg);
  }
  .dial-horizon {
    position: absolute;
    top: 45px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--dial-horizon);
    z-index: 2;
  }
  .dial-ground {
    position: absolute;
    left: -8px;
    top: 46px;
    width: 90px;
    height: 40px;
    border-radius: 45% 70% 0 0;
    background: var(--dial-ground);
    z-index: 3;
  }
  .dial-ground span {
    position: absolute;
    width: 80px;
    height: 35px;
    background: var(--dial-ground-front);
    border-radius: 80% 25% 0 0;
    top: 9px;
    left: 18px;
  }
  .dial-tick {
    position: absolute;
    width: 2px;
    height: 4px;
    border-radius: 2px;
    background: var(--muted);
    bottom: 1px;
    left: 42px;
    opacity: 0.5;
  }
  .dial-stars {
    position: absolute;
    z-index: 1;
    left: 13px;
    top: 11px;
    color: #e8dfb4;
    width: 44px;
    height: 18px;
    opacity: 0;
    transform: translateY(4px);
  }
  .theme-hint {
    visibility: hidden;
    display: block;
    text-align: center;
    margin-top: 13px;
    width: 120px;
    max-width: calc(100% + 20px);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    transform: rotate(-5deg);
  }
  .theme-dial:not([hidden]) + .theme-hint {
    visibility: visible;
  }
  .night-hint {
    display: none;
  }
  :global([data-theme='dark']) .dial-orbit {
    transform: rotate(180deg);
  }
  :global([data-theme='dark']) .dial-stars {
    opacity: 1;
    transform: translateY(0);
  }
  :global([data-theme='dark']) .day-hint {
    display: none;
  }
  :global([data-theme='dark']) .night-hint {
    display: inline;
  }
  :global(.theme-ready) .dial-orbit {
    transition: transform 1050ms cubic-bezier(0.4, 0, 0.15, 1);
  }
  :global(.theme-ready) .dial-sky,
  :global(.theme-ready) .dial-ground,
  :global(.theme-ready) .dial-ground span,
  :global(.theme-ready) .dial-case {
    transition: background 850ms ease;
  }
  :global(.theme-ready) .dial-stars {
    transition:
      opacity 650ms ease 150ms,
      transform 850ms ease;
  }
  .theme-dial:hover .dial-case {
    transform: rotate(0deg) translateY(-2px);
  }
  .theme-dial:active .dial-case {
    transform: rotate(3deg) scale(0.95);
  }
  :global(.theme-ready) .dial-case {
    transition:
      transform 250ms ease,
      background 850ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-dial *,
    :global(.theme-ready) .theme-dial * {
      transition: none !important;
    }
    .theme-dial:hover .dial-case,
    .theme-dial:active .dial-case {
      transform: rotate(-8deg);
    }
  }
  @media (max-width: 480px) {
    .theme-control {
      width: 86px;
    }
    .theme-dial {
      width: 86px;
    }
    .theme-hint {
      font-size: 9px;
    }
  }
  @media print {
    .theme-control {
      display: none;
    }
  }
</style>
