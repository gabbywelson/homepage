---
import '../../styles/prose.css';
import PageLayout from '../../layouts/PageLayout.astro';
import WorkList from '../WorkList.astro';
import BrandLogo from '../BrandLogo.astro';
import Icon from '../Icon.astro';
import { render } from 'astro:content';
import {
  profileContent,
  resumeEntry,
  resumeEntries,
  formatPeriod,
} from '../../i18n/profile';
import { localeFromPath } from '../../i18n/locales';
import { messages } from '../../i18n/messages';
const locale = localeFromPath(Astro.url.pathname);
const ui = messages(locale);
const content = await profileContent('/resume/', locale);
const fallback = content.locale !== locale;
const intro = resumeEntry(content.resume, 'intro', 'intro');
const before = resumeEntry(content.resume, 'section', 'before-software');
const { Content: Intro } = await render(intro);
const { Content: Before } = await render(before);
const copy = intro.data;
const education = resumeEntries(content.resume, 'education').map(
  (entry) => entry.data,
);
const skills = await Promise.all(
  resumeEntries(content.resume, 'skill').map(async (entry) => ({
    title: entry.data.title,
    ...(await render(entry)),
  })),
);
---

<PageLayout
  contentLanguage={content.locale}
  canonicalPath={fallback ? '/resume/' : undefined}
  title={copy.title}
  eyebrow={copy.eyebrow}
  intro={copy.description}
>
  {
    fallback && (
      <p class="content-footer" lang={locale}>
        {ui.englishLink} ·{' '}
        <a href="/resume/" hreflang="en">
          {ui.original}
        </a>
      </p>
    )
  }
  <div class="prose">
    <Intro />
    <p>
      <a class="quiet-link" href="https://www.linkedin.com/in/gabbywelson/"
        ><Icon name="linkedin" /> {copy.linkedinLabel} <Icon name="arrow" /></a
      >
    </p>
  </div>
  <section class="page-section" aria-labelledby="experience">
    <h2 id="experience">{copy.experienceTitle}</h2><WorkList
      detailed
      entries={content.resume}
      locale={content.locale}
      currentLabel={copy.currentLabel}
      presentLabel={copy.presentLabel}
    />
  </section>
  <section class="page-section prose" aria-labelledby="earlier-experience">
    <h2 id="earlier-experience">{before.data.title}</h2>
    <Before />
  </section>
  <section class="page-section" aria-labelledby="education">
    <h2 id="education">{copy.educationTitle}</h2>
    <ul class="education-list">
      {
        education.map((entry) => (
          <li>
            <BrandLogo name={entry.brand} variant="list" />
            <div>
              <h3>
                <a href={entry.href}>{entry.title}</a>
              </h3>
              <p>{entry.qualification}</p>
              <p class="education-list__period">
                {formatPeriod(
                  entry.start,
                  entry.end,
                  content.locale,
                  copy.presentLabel,
                )}
              </p>
              <p class="education-list__location">{entry.location}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="page-section" aria-labelledby="skills">
    <h2 id="skills">{copy.skillsTitle}</h2>
    <dl class="skills-list">
      {
        skills.map((skill) => (
          <div>
            <>
              <dt>{skill.title}</dt>
              <dd>
                <skill.Content />
              </dd>
            </>
          </div>
        ))
      }
    </dl>
  </section>
</PageLayout>

<style>
  .education-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .education-list li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    padding: 20px 0;
  }

  .education-list li + li {
    border-top: 1px solid var(--line);
  }

  .education-list a {
    color: inherit;
    text-decoration: none;
  }

  .education-list a:hover {
    color: var(--rose);
    text-decoration: underline;
  }

  .education-list p {
    font-size: 0.9375rem;
  }

  .education-list .education-list__period,
  .education-list .education-list__location {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .education-list__period {
    margin-top: 5px;
  }

  .skills-list {
    margin: 0;
    font-size: 0.9375rem;
  }

  .skills-list > div + div {
    margin-top: 19px;
  }

  .skills-list dt {
    font-weight: 600;
  }

  .skills-list dd {
    margin: 4px 0 0;
  }

  @media (max-width: 370px) {
    .education-list li {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
