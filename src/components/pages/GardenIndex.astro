---
import '../../styles/prose.css';
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import { gardenPages } from '../../data/site';
import { render } from 'astro:content';
import { getPosts, formatDate } from '../../lib/posts';
import { localeFromPath, contentIdentity } from '../../i18n/locales';
import { messages } from '../../i18n/messages';
import {
  localizedEntries,
  contentPath,
  availablePaths,
  availableHref,
} from '../../i18n/content';
const href = (path: string) => availableHref(path, locale, paths);
const locale = localeFromPath(Astro.url.pathname);
const ui = messages(locale);
const paths = await availablePaths(locale);
const pages = await localizedEntries('pages', locale);
const entry = pages.find((page) => contentIdentity(page.id).slug === 'garden');
if (!entry) throw new Error('Missing garden introduction');
const { Content } = await render(entry);
const notes = (await localizedEntries('notes', locale)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, locale),
);
const recentPosts = (await getPosts(locale)).slice(0, 3);
---

<PageLayout
  title={ui.garden}
  description={entry.data.description}
  eyebrow={ui.gardenEyebrow}
>
  <div class="prose"><Content /></div>
  <section class="page-section" aria-labelledby="garden-paths">
    <h2 id="garden-paths">{ui.gardenPaths}</h2>
    <ul class="garden-list">
      {
        gardenPages
          .filter(
            (page) =>
              locale === 'en' ||
              (paths.has(href(`/${page.slug}/`)) &&
                href(`/${page.slug}/`) !== `/${page.slug}/`),
          )
          .map((page) => (
            <li>
              <a href={href(`/${page.slug}/`)}>
                <span
                  class:list={[
                    'garden-list__mark',
                    `garden-list__mark--${page.tone}`,
                  ]}
                >
                  <Icon name={page.icon} />
                </span>
                <div>
                  <>
                    <h3>
                      {locale === 'en'
                        ? page.title
                        : pages.find(
                            (entry) =>
                              contentIdentity(entry.id).slug === page.slug,
                          )?.data.title}
                      <span class="garden-list__path">/{page.slug}</span>
                    </h3>
                    <p>
                      {locale === 'en'
                        ? page.description
                        : pages.find(
                            (entry) =>
                              contentIdentity(entry.id).slug === page.slug,
                          )?.data.description}
                    </p>
                  </>
                </div>
                <Icon name="right" />
              </a>
            </li>
          ))
      }
    </ul>
  </section>
  <section class="page-section" aria-labelledby="garden-notes">
    <h2 id="garden-notes">{ui.gardenNotes}</h2>
    <ul class="note-list">
      {
        notes.map((note) => (
          <li>
            <>
              <a href={contentPath('notes', note.id)}>
                {note.data.title} <Icon name="right" />
              </a>
              <p>{note.data.description}</p>
            </>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="page-section" aria-labelledby="recent-posts">
    <h2 id="recent-posts">{ui.recentPosts}</h2>
    <ul class="note-list">
      {
        recentPosts.map((post) => (
          <li>
            <>
              <a href={contentPath('blog', post.id)}>{post.data.title}</a>
              <p>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, locale)}
                </time>
              </p>
            </>
          </li>
        ))
      }
    </ul>
    <p class="content-footer">
      <a class="quiet-link" href={href('/blog/')}
        >{ui.allPosts} <Icon name="right" /></a
      >
    </p>
  </section>
</PageLayout>

<style>
  .garden-list,
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .garden-list li + li,
  .note-list li + li {
    border-top: 1px solid var(--line);
  }

  .garden-list a {
    --icon-color: var(--muted);
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 20px;
    align-items: center;
    column-gap: 18px;
    padding: 23px 0;
    color: inherit;
    text-decoration: none;
  }

  .garden-list a:hover h3 {
    color: var(--rose);
  }

  .garden-list h3 {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 550;
    line-height: 1.5;
    letter-spacing: -0.055em;
  }

  .garden-list p {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .garden-list__path {
    margin-left: 10px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
  }

  .garden-list__mark {
    --icon-size: 22px;
    --icon-color: currentColor;
    display: grid;
    place-items: center;
    width: 37px;
    height: 37px;
    border-radius: 11px;
  }

  .garden-list__mark--rose {
    color: var(--rose);
    background: var(--rose-soft);
  }

  .garden-list__mark--sage {
    color: var(--sage);
    background: var(--sage-soft);
  }

  .garden-list__mark--lilac {
    color: var(--lilac);
    background: var(--lilac-soft);
  }

  .garden-list__mark--gold {
    color: var(--gold);
    background: var(--gold-soft);
  }

  .note-list li {
    padding: 16px 0;
  }

  .note-list a {
    --icon-size: 16px;
    font-weight: 550;
  }

  .note-list p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (max-width: 370px) {
    .garden-list__path {
      display: none;
    }
  }
</style>
