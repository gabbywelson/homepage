---
import '../../styles/content.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeDial from '../ThemeDial.astro';
import WorkList from '../WorkList.astro';
import Icon from '../Icon.astro';
import { render } from 'astro:content';
import HomeAccent from '../HomeAccent.astro';
import HomeLink from '../HomeLink.astro';
import { profileContent } from '../../i18n/profile';
import { availableLink, availablePaths } from '../../i18n/content';
import { localeFromPath } from '../../i18n/locales';
import { messages } from '../../i18n/messages';
const locale = localeFromPath(Astro.url.pathname);
const ui = messages(locale);
const content = await profileContent('/', locale);
const copy = content.home.data;
const { Content } = await render(content.home);
const fallback = content.locale !== locale;
const paths = await availablePaths(locale);
const link = (path: string) => availableLink(path, locale, paths);
---

<BaseLayout
  contentLanguage={content.locale}
  canonicalPath={fallback ? '/' : undefined}
  description={copy.description}
>
  {
    fallback && (
      <p class="content-footer" lang={locale}>
        {ui.englishLink} ·{' '}
        <a href="/" hreflang="en">
          {ui.original}
        </a>
      </p>
    )
  }
  <section class="home-intro" aria-labelledby="hello">
    <div class="home-intro__heading">
      <div>
        <p class="eyebrow">
          {copy.eyebrow}
          <span aria-hidden="true">✳</span>
        </p><h1 id="hello">
          {copy.title}<span class="heading-dot">.</span>
        </h1>
      </div>
      <ThemeDial />
    </div>
    <div class="home-intro__copy">
      <Content components={{ a: HomeLink, Accent: HomeAccent, HomeLink }} />
    </div>
    <a class="quiet-link home-intro__now" {...link('/now/')}
      ><span class="home-intro__status" aria-hidden="true"></span>
      {copy.nowLabel}
      <Icon name="right" /></a
    >
  </section>
  <section class="home-work" aria-labelledby="work-heading">
    <div class="home-work__heading">
      <h2 id="work-heading">{copy.workTitle}</h2><a
        {...link('/resume/')}
        class="quiet-link">{copy.resumeLabel} <Icon name="arrow" /></a
      >
    </div>
    <WorkList
      entries={content.resume}
      locale={content.locale}
      currentLabel={copy.currentLabel}
    />
  </section>
  <aside class="garden-invitation">
    <Icon name="plant" /><p>
      {copy.invitation}<br /><a {...link('/garden/')}
        >{copy.gardenLabel} <Icon name="right" /></a
      >
    </p><span aria-hidden="true" class="garden-invitation__asterisk">✳</span>
  </aside>
</BaseLayout>

<style>
  .home-intro__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 32px;
  }

  .eyebrow span {
    display: inline-block;
    padding-left: 5px;
    color: var(--rose);
    font-size: 0.9375rem;
  }

  .home-intro__copy :global(p + p) {
    margin-top: 20px;
  }

  .home-intro__now {
    margin-top: 28px;
  }

  .home-intro__status {
    width: 6px;
    height: 6px;
    margin-right: 2px;
    background: var(--sage);
    border-radius: 50%;
  }

  .home-work {
    margin-top: 57px;
  }

  .home-work__heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 21px;
  }

  .garden-invitation {
    --icon-size: 28px;
    --icon-color: var(--sage);
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 42px;
    padding: 19px 22px;
    background: var(--sage-soft);
    border-radius: 5px 17px 17px 17px;
  }

  .garden-invitation p {
    font-size: 0.8125rem;
    line-height: 1.9;
  }

  .garden-invitation a {
    --icon-size: 14px;
    color: var(--sage);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .garden-invitation a:hover {
    text-decoration: underline;
  }

  .garden-invitation__asterisk {
    margin-left: auto;
    color: var(--sage);
    font-size: 1.375rem;
    opacity: 0.55;
  }

  @media (max-width: 600px) {
    .home-intro__heading {
      margin-bottom: 25px;
    }

    .garden-invitation {
      gap: 12px;
      padding: 16px;
    }
  }
</style>
