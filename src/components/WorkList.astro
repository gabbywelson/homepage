---
import { render, type CollectionEntry } from 'astro:content';
import BrandLogo from './BrandLogo.astro';
import { formatPeriod, resumeEntries } from '../i18n/profile';
import { contentIdentity, type Locale } from '../i18n/locales';
interface Props {
  detailed?: boolean;
  entries: CollectionEntry<'resume'>[];
  locale: Locale;
  currentLabel: string;
  presentLabel?: string;
}
const {
  detailed = false,
  entries,
  locale,
  currentLabel,
  presentLabel = currentLabel,
} = Astro.props;
const companies = resumeEntries(entries, 'company');
const roles = resumeEntries(entries, 'role');
for (const role of roles) {
  if (
    !companies.some(
      (company) =>
        contentIdentity(company.id).slug === `companies/${role.data.company}`,
    )
  )
    throw new Error(`Unknown company ${role.data.company} in ${role.id}`);
}
const work = await Promise.all(
  companies.map(async (company) => ({
    ...company.data,
    company: company.data.title,
    period: formatPeriod(
      company.data.start,
      company.data.end,
      locale,
      currentLabel,
      true,
    ),
    roles: detailed
      ? await Promise.all(
          roles
            .filter(
              (role) =>
                contentIdentity(company.id).slug ===
                `companies/${role.data.company}`,
            )
            .map(async (role) => ({
              title: role.data.title,
              period: formatPeriod(
                role.data.start,
                role.data.end,
                locale,
                presentLabel,
              ),
              ...(await render(role)),
            })),
        )
      : [],
  })),
);
---

<ol class:list={['work-list', { 'work-list--detailed': detailed }]}>
  {
    work.map((item) => (
      <li class="work-list__item">
        <BrandLogo name={item.brand} variant="list" />
        <div class="work-list__info">
          <h3>
            {item.href ? <a href={item.href}>{item.company}</a> : item.company}
          </h3>
          {(!detailed || item.location) && (
            <p>{detailed ? item.location : item.summary}</p>
          )}
        </div>
        {item.period && <span class="work-list__period">{item.period}</span>}
        {detailed && (
          <div class="work-list__roles">
            {item.roles.map((role) => (
              <section class="work-list__role">
                <h4>{role.title}</h4>
                {role.period && (
                  <p class="work-list__role-period">{role.period}</p>
                )}
                <div class="work-list__highlights">
                  <role.Content />
                </div>
              </section>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-list__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
  }

  .work-list__item + .work-list__item {
    border-top: 1px solid var(--line);
  }

  .work-list__info {
    min-width: 0;
  }

  .work-list__info h3 {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .work-list__info a {
    color: inherit;
    text-decoration: none;
  }

  .work-list__info a:hover {
    color: var(--rose);
    text-decoration: underline;
  }

  .work-list__info p {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .work-list__period {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .work-list__roles {
    grid-column: 2 / -1;
    min-width: 0;
  }

  .work-list__role + .work-list__role {
    margin-top: 30px;
  }

  .work-list__role h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .work-list__role-period {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* Markdown descendants are rendered outside Astro component scope. */
  .work-list__highlights :global(ul) {
    margin: 14px 0 0;
    padding-left: 19px;
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .work-list__highlights :global(li + li) {
    margin-top: 11px;
  }

  .work-list__highlights :global(li)::marker {
    color: var(--sage);
  }

  .work-list--detailed .work-list__item {
    align-items: start;
    padding: 25px 0;
  }

  .work-list--detailed .work-list__period {
    margin-top: 6px;
  }

  @media (max-width: 600px) {
    .work-list__period {
      font-size: 0.625rem;
    }

    .work-list--detailed .work-list__roles {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 370px) {
    .work-list__item {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
    }

    .work-list__period {
      grid-column: 2;
      margin-top: -8px;
    }
  }

  @media print {
    .work-list__item {
      break-inside: avoid;
    }
  }
</style>
