---
import BrandLogo from './BrandLogo.astro';
import { work } from '../data/work';
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<ol class:list={['work-list', { 'work-list--detailed': detailed }]}>
  {
    work.map((item) => (
      <li class="work-list__item">
        <BrandLogo name={item.brand} variant="list" />
        <div class="work-list__info">
          <h3>
            {item.href ? <a href={item.href}>{item.company}</a> : item.company}
          </h3>
          {(!detailed || item.location) && (
            <p>{detailed ? item.location : item.summary}</p>
          )}
        </div>
        {item.period && <span class="work-list__period">{item.period}</span>}
        {detailed && (
          <div class="work-list__roles">
            {item.roles.map((role) => (
              <section class="work-list__role">
                <h4>{role.title}</h4>
                {role.period && (
                  <p class="work-list__role-period">{role.period}</p>
                )}
                <ul class="work-list__highlights">
                  {role.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-list__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
  }

  .work-list__item + .work-list__item {
    border-top: 1px solid var(--line);
  }

  .work-list__info {
    min-width: 0;
  }

  .work-list__info h3 {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .work-list__info a {
    color: inherit;
    text-decoration: none;
  }

  .work-list__info a:hover {
    color: var(--rose);
    text-decoration: underline;
  }

  .work-list__info p {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .work-list__period {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .work-list__roles {
    grid-column: 2 / -1;
    min-width: 0;
  }

  .work-list__role + .work-list__role {
    margin-top: 30px;
  }

  .work-list__role h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .work-list__role-period {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .work-list__highlights {
    margin: 14px 0 0;
    padding-left: 19px;
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .work-list__highlights li + li {
    margin-top: 11px;
  }

  .work-list__highlights li::marker {
    color: var(--sage);
  }

  .work-list--detailed .work-list__item {
    align-items: start;
    padding: 25px 0;
  }

  .work-list--detailed .work-list__period {
    margin-top: 6px;
  }

  @media (max-width: 600px) {
    .work-list__period {
      font-size: 0.625rem;
    }

    .work-list--detailed .work-list__roles {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 370px) {
    .work-list__item {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
    }

    .work-list__period {
      grid-column: 2;
      margin-top: -8px;
    }
  }

  @media print {
    .work-list__item {
      break-inside: avoid;
    }
  }
</style>
