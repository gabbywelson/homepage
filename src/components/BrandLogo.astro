---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { BrandName } from '../types/site';
import handshake from '../assets/brands/handshake.png';
import linkedin from '../assets/brands/linkedin.png';
import hackReactor from '../assets/brands/hack-reactor.png';
import williams from '../assets/brands/williams-college.png';
import exeter from '../assets/brands/exeter-college.png';

const logos = {
  handshake,
  linkedin,
  'hack-reactor': hackReactor,
  williams,
  exeter,
} satisfies Record<BrandName, ImageMetadata>;
interface Props {
  name: BrandName;
  variant?: 'inline' | 'list';
}
const { name, variant = 'inline' } = Astro.props;
const size = variant === 'list' ? 36 : 24;
---

<!-- Adjacent text supplies the name; decorative logos should not repeat it. -->
<Image
  src={logos[name]}
  class="brand-logo"
  data-brand={name}
  data-variant={variant}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  layout="fixed"
  widths={[size, size * 2, size * 3]}
  format="webp"
  fit="contain"
  quality={90}
  loading={variant === 'inline' ? 'eager' : 'lazy'}
  decoding="async"
/>

<style>
  .brand-logo {
    display: inline-block;
    width: 24px;
    height: 24px;
    vertical-align: -0.36em;
    margin-right: 3px;
    border-radius: 5px;
    object-fit: contain;
    background: white;
  }
  .brand-logo[data-brand='handshake'] {
    background: #d7fb45;
  }
  .brand-logo[data-brand='linkedin'] {
    background: #2867b2;
  }
  .brand-logo[data-brand='williams'] {
    background: #500082;
  }
  .brand-logo[data-brand='exeter'] {
    padding: 3px;
  }
  .brand-logo[data-variant='list'] {
    display: block;
    width: 36px;
    height: 36px;
    margin: 0;
    border-radius: 9px;
  }
</style>
