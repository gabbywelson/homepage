---
import '../styles/content.css';
import BaseLayout from './BaseLayout.astro';
import ThemeDial from '../components/ThemeDial.astro';
interface Props {
  title: string;
  intro?: string | undefined;
  description?: string | undefined;
  eyebrow?: string | undefined;
  noindex?: boolean | undefined;
  contentLanguage?: string | undefined;
  canonicalPath?: string | undefined;
}
const {
  title,
  intro,
  description = intro,
  eyebrow,
  noindex,
  contentLanguage,
  canonicalPath,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  contentLanguage={contentLanguage}
  canonicalPath={canonicalPath}
>
  <div class="page-heading">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}<h1>
        {title}<span class="heading-dot">.</span>
      </h1>
    </div><ThemeDial />
  </div>
  {intro && <p class="page-intro">{intro}</p>}
  <slot />
</BaseLayout>

<style>
  .page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 20px;
  }

  .page-heading h1 {
    font-size: 2.55rem;
  }

  .page-intro {
    max-width: 490px;
    margin-bottom: 38px;
    color: var(--muted);
  }
</style>
