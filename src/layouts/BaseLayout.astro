---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import {
  availablePaths,
  availableHref,
  languageAlternates,
} from '../i18n/content';
import { languages, localeFromPath, sourcePath } from '../i18n/locales';
import { messages } from '../i18n/messages';
import { site } from '../data/site';
import themeBootstrap from '../scripts/theme-bootstrap.js?raw';

const locale = localeFromPath(Astro.url.pathname);
const ui = messages(locale);
const paths = await availablePaths(locale);
const href = (path: string) => availableHref(path, locale, paths);
const linkLanguage = (path: string) =>
  locale !== 'en' && href(path) === path ? 'en' : undefined;
const alternates = await languageAlternates(Astro.url.pathname);
const rssHref =
  locale === 'en' ? '/rss.xml' : `/${locale.toLowerCase()}/rss.xml`;

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean | undefined;
  article?: boolean | undefined;
  published?: Date | undefined;
}
const {
  title,
  description = ui.siteDescription,
  noindex = false,
  article = false,
  published,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = sourcePath(Astro.url.pathname);
const active = (href: string) =>
  path.startsWith(href) ||
  (href === '/garden/' &&
    ['/now/', '/uses/', '/about/', '/colophon/'].includes(path));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f3" />
    <script is:inline set:html={themeBootstrap} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {
      (noindex || !site.indexable) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={canonical} />
    {
      alternates.length > 1 && (
        <>
          {alternates.map((alternate) => (
            <link
              rel="alternate"
              hreflang={alternate.locale}
              href={new URL(alternate.href, site.url).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(sourcePath(Astro.url.pathname), site.url).href}
          />
        </>
      )
    }
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={languages[locale].og} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      published && (
        <meta
          property="article:published_time"
          content={published.toISOString()}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — ${ui.blog}`}
      href={rssHref}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipContent}</a>
    <div class="site-shell">
      <header class="site-header">
        <a
          class="wordmark"
          href={href('/')}
          hreflang={linkLanguage('/')}
          aria-label={ui.homeLabel}
          ><Icon name="plant" /><span
            >gabby<span class="wordmark-dot">.</span></span
          ></a
        >
        <nav aria-label={ui.mainNavigation}>
          <a
            href={href('/blog/')}
            hreflang={linkLanguage('/blog/')}
            aria-current={active('/blog/') ? 'page' : undefined}>{ui.blog}</a
          >
          <a
            href={href('/resume/')}
            hreflang={linkLanguage('/resume/')}
            aria-current={active('/resume/') ? 'page' : undefined}
            >{ui.resume}{
              linkLanguage('/resume/') && (
                <span class="sr-only"> ({ui.englishLink})</span>
              )
            }</a
          >
          <a
            href={href('/garden/')}
            hreflang={linkLanguage('/garden/')}
            aria-current={active('/garden/') ? 'page' : undefined}
            >{ui.garden} <Icon name="plant" /></a
          >
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="footer-main">
          <a
            href={href('/')}
            hreflang={linkLanguage('/')}
            class="footer-signature h-card u-url"
            rel="author"
          >
            <span>© {new Date().getFullYear()},</span>
            <span class="p-name">{ui.signature}</span>
          </a>
          <nav class="social-links" aria-label={ui.elsewhere}>
            {
              site.social.map((social) => (
                <a
                  href={social.href}
                  rel="me"
                  aria-label={social.name}
                  title={social.name}
                >
                  <Icon name={social.icon} />
                </a>
              ))
            }
            <a href={rssHref} aria-label={ui.subscribe} title={ui.subscribe}
              ><Icon name="rss" /></a
            >
          </nav>
        </div>
        <div class="footer-bottom">
          <div class="footer-note">
            {ui.madeWith}
          </div><LanguagePicker />
        </div>
      </footer>
    </div>
  </body>
</html>
<style>
  .site-shell {
    max-width: 792px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 33px 0 26px;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    --icon-size: 27px;
    --icon-color: var(--sage);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 550;
    letter-spacing: -0.07em;
    text-decoration: none;
  }

  .wordmark-dot {
    color: var(--rose);
  }

  .site-header nav {
    --icon-size: 17px;
    --icon-color: var(--sage);
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 0.875rem;
  }

  .site-header nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current] {
    color: var(--text);
  }

  .site-header nav a[aria-current]::after {
    position: absolute;
    bottom: 1px;
    left: calc(50% - 6px);
    width: 12px;
    height: 3px;
    background: var(--rose);
    border-radius: 5px;
    content: '';
  }

  main {
    max-width: 624px;
    min-height: 60vh;
    margin: 0 auto;
    padding: 73px 0 66px;
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    padding: 23px 0 32px;
    border-top: 1px solid var(--line);
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .footer-signature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .social-links {
    --icon-size: 18px;
    display: flex;
    gap: 5px;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 36px;
    color: var(--muted);
  }

  .social-links a:hover {
    color: var(--rose);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 12px;
  }

  .footer-note {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 12px;
    left: 12px;
    padding: 9px 15px;
    border: 1px solid var(--rose);
    border-radius: 4px;
    background: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 600px) {
    .site-shell {
      padding: 0 24px;
    }

    .site-header {
      flex-wrap: wrap;
      gap: 10px;
      padding: 19px 0 16px;
    }

    .site-header nav {
      gap: 20px;
      font-size: 0.8125rem;
    }

    main {
      padding: 48px 0;
    }

    .footer-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .footer-signature {
      flex-wrap: wrap;
      gap: 4px 8px;
    }

    .social-links {
      flex-wrap: wrap;
      gap: 0;
      margin-left: -13px;
    }

    .social-links a {
      width: 44px;
      height: 44px;
    }

    .footer-note {
      margin-top: 12px;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 370px) {
    .site-shell {
      padding: 0 19px;
    }

    .site-header nav {
      gap: 12px;
    }

    .wordmark {
      --icon-size: 23px;
      gap: 4px;
      font-size: 1rem;
    }
  }

  @media print {
    .site-header,
    .site-footer,
    .skip-link {
      display: none;
    }

    .site-shell,
    main {
      max-width: none;
      padding: 0;
    }
  }
</style>
