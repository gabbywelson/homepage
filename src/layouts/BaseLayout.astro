---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; article?: boolean; published?: Date; }
const { title, description = site.description, noindex = false, article = false, published } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href) || (href === '/garden/' && ['/now/', '/uses/', '/about/', '/colophon/'].includes(path));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f3" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {(noindex || !site.indexable) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/maple-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Gabby Welson — home"><Icon name="plant" /><span>gabby<span class="wordmark-dot">.</span></span></a>
        <nav aria-label="Main navigation">
          <a href="/blog/" aria-current={active('/blog/') ? 'page' : undefined}>Blog</a>
          <a href="/resume/" aria-current={active('/resume/') ? 'page' : undefined}>Résumé</a>
          <a href="/garden/" aria-current={active('/garden/') ? 'page' : undefined}>Garden <Icon name="plant" /></a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="footer-main">
          <a href="/" class="footer-signature h-card u-url" rel="author"><Icon name="flower" /><span class="p-name">Gabby Welson</span></a>
          <nav class="social-links" aria-label="Elsewhere and subscriptions">
            {site.social.map((social) => <a href={social.href} rel="me" aria-label={social.name} title={social.name}><Icon name={social.icon} /></a>)}
            <a href="/rss.xml" aria-label="Subscribe via RSS" title="Subscribe via RSS"><Icon name="rss" /></a>
          </nav>
        </div>
        <div class="footer-note"><span>A small, growing thing. <span aria-hidden="true">❀</span></span><a href="/colophon/">Made with care <Icon name="arrow" /></a></div>
      </footer>
    </div>
  </body>
</html>
