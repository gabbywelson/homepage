---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import themeBootstrap from '../scripts/theme-bootstrap.js?raw';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean | undefined;
  article?: boolean | undefined;
  published?: Date | undefined;
}
const {
  title,
  description = site.description,
  noindex = false,
  article = false,
  published,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const active = (href: string) =>
  path.startsWith(href) ||
  (href === '/garden/' &&
    ['/now/', '/uses/', '/about/', '/colophon/'].includes(path));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f3" />
    <script is:inline set:html={themeBootstrap} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {
      (noindex || !site.indexable) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      published && (
        <meta
          property="article:published_time"
          content={published.toISOString()}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Blog`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Gabby Welson — home"
          ><Icon name="plant" /><span
            >gabby<span class="wordmark-dot">.</span></span
          ></a
        >
        <nav aria-label="Main navigation">
          <a href="/blog/" aria-current={active('/blog/') ? 'page' : undefined}
            >Blog</a
          >
          <a
            href="/resume/"
            aria-current={active('/resume/') ? 'page' : undefined}>Résumé</a
          >
          <a
            href="/garden/"
            aria-current={active('/garden/') ? 'page' : undefined}
            >Garden <Icon name="plant" /></a
          >
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="footer-main">
          <a href="/" class="footer-signature h-card u-url" rel="author">
            <span>© {new Date().getFullYear()},</span>
            <span class="p-name">gabby welson (she/her)</span>
          </a>
          <nav class="social-links" aria-label="Elsewhere and subscriptions">
            {
              site.social.map((social) => (
                <a
                  href={social.href}
                  rel="me"
                  aria-label={social.name}
                  title={social.name}
                >
                  <Icon name={social.icon} />
                </a>
              ))
            }
            <a
              href="/rss.xml"
              aria-label="Subscribe via RSS"
              title="Subscribe via RSS"><Icon name="rss" /></a
            >
          </nav>
        </div>
        <div class="footer-note">
          <span>made with 💜 in san francisco</span><a href="/colophon/"
            >read the colophon <Icon name="arrow" /></a
          >
        </div>
      </footer>
    </div>
  </body>
</html>
<style>
  .site-shell {
    max-width: 792px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 33px 0 26px;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    --icon-size: 27px;
    --icon-color: var(--sage);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 550;
    letter-spacing: -0.07em;
    text-decoration: none;
  }

  .wordmark-dot {
    color: var(--rose);
  }

  .site-header nav {
    --icon-size: 17px;
    --icon-color: var(--sage);
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 0.875rem;
  }

  .site-header nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current] {
    color: var(--text);
  }

  .site-header nav a[aria-current]::after {
    position: absolute;
    bottom: 1px;
    left: calc(50% - 6px);
    width: 12px;
    height: 3px;
    background: var(--rose);
    border-radius: 5px;
    content: '';
  }

  main {
    max-width: 624px;
    min-height: 60vh;
    margin: 0 auto;
    padding: 73px 0 66px;
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    padding: 23px 0 32px;
    border-top: 1px solid var(--line);
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .footer-signature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .social-links {
    --icon-size: 18px;
    display: flex;
    gap: 5px;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 36px;
    color: var(--muted);
  }

  .social-links a:hover {
    color: var(--rose);
  }

  .footer-note {
    --icon-size: 12px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .footer-note a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-note a:hover {
    color: var(--rose);
    text-decoration: underline;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 12px;
    left: 12px;
    padding: 9px 15px;
    border: 1px solid var(--rose);
    border-radius: 4px;
    background: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 600px) {
    .site-shell {
      padding: 0 24px;
    }

    .site-header {
      padding: 19px 0 16px;
    }

    .site-header nav {
      gap: 20px;
      font-size: 0.8125rem;
    }

    main {
      padding: 48px 0;
    }

    .footer-main,
    .footer-note {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .footer-signature {
      flex-wrap: wrap;
      gap: 4px 8px;
    }

    .social-links {
      flex-wrap: wrap;
      gap: 0;
      margin-left: -13px;
    }

    .social-links a {
      width: 44px;
      height: 44px;
    }

    .footer-note {
      gap: 0;
      margin-top: 12px;
      font-size: 0.75rem;
    }

    .footer-note a {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 44px;
    }
  }

  @media (max-width: 370px) {
    .site-shell {
      padding: 0 19px;
    }

    .site-header nav {
      gap: 12px;
    }

    .wordmark {
      --icon-size: 23px;
      gap: 4px;
      font-size: 1rem;
    }
  }

  @media print {
    .site-header,
    .site-footer,
    .skip-link {
      display: none;
    }

    .site-shell,
    main {
      max-width: none;
      padding: 0;
    }
  }
</style>
