{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "types": ["node"],
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["dist", "node_modules", "test-results", "playwright-report"]
}
