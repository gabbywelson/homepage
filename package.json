{
  "name": "homepage",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/hosting.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "bun run build && playwright test",
    "typecheck": "astro check --minimumFailingSeverity warning && node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:performance": "bun run build && node scripts/lighthouse.mjs",
    "build:production": "SITE_INDEXABLE=true bun run build",
    "deploy": "bun run build:production && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.3.1",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.129.0"
  },
  "packageManager": "bun@1.3.14"
}
