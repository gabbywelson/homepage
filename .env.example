# Build-time only. Create a classic PAT with read:user in EACH account.
# Add these to .env.local (preserving any existing variables) or your build secrets.
# Never use PUBLIC_ prefixes. Full setup: docs/github-activity.md
GITHUB_PERSONAL_TOKEN=
GITHUB_WORK_TOKEN=

# Optional labeled, synthetic preview; production/indexable builds reject this.
GITHUB_ACTIVITY_DEMO=false
